{
  "name": "recipe-book",
  "version": "0.1.0",
  "private": true,
  "description": "Highball-style recipe cards for the household: public reads, Cognito-gated writes, bearer-secret import API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local.ts",
    "web": "npm run dev --prefix web",
    "all": "concurrently -n api,web -c cyan,magenta \"npm run dev\" \"npm run web\"",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "add-user": "scripts/add-user.sh",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@libsql/client": "^0.18.0",
    "aws-jwt-verify": "^5.1.0",
    "express": "^5.1.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  }
}
