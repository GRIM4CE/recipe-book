# libsql database. Local file in dev; Turso URL + token in prod.
DB_URL=file:./data/recipe-book.db
DB_AUTH_TOKEN=

# Local API server port (Vite proxies /api here).
RECIPE_SERVER_PORT=4181

# Deployed web origin allowed by CORS (the Amplify URL). localhost:5173 is
# always allowed.
WEB_ORIGIN=

# Bearer secret for /api/external/* (importer push). Empty disables the
# external API. Generate with: openssl rand -hex 32
EXTERNAL_API_SECRET=dev-secret

# Cognito pool for UI write auth. Leave empty locally: writes then run as the
# "dev" user (refused in production).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# S3 photo storage. Leave empty locally: photos are stored in data/photos/.
S3_BUCKET=
S3_REGION=

# Where local photos and the dev db live.
RECIPE_DATA_DIR=./data
